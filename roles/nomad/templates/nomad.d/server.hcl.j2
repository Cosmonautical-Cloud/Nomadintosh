{# datacenter is set by the set_facts role from this host's DNS name
   (hopper.jellify.app -> jellify) - it's a job-placement tag, distinct from
   Consul's datacenter (see consul.d/server.hcl.j2). existing_cluster_servers
   is optional - see that template for when/why to set it; it's the same
   variable, merged into retry_join here too so this host's Nomad agent can
   find servers that aren't part of this run's own inventory. #}
{% set nomad_client_meta_merged = {} %}
{% for d in [nomad_client_meta | default({})] + query('ansible.builtin.vars', *query('ansible.builtin.varnames', '^nomad_client_meta__.+$') | sort) %}
{%   set _ = nomad_client_meta_merged.update(d) %}
{% endfor %}
{# Collect all Nomad server hostnames from inventory #}
{% set ns = namespace(servers=[]) %}
{% for host in groups['all'] %}
{%   if 'server' in hostvars[host] and hostvars[host]['server'] is mapping and hostvars[host]['server']['enabled'] | default(false) %}
{%     set ns.servers = ns.servers + [host] %}
{%   endif %}
{% endfor %}
{% set retry_join_hosts = (ns.servers + (existing_cluster_servers | default([]))) | unique %}
datacenter = "{{ datacenter }}"
name = "{{ inventory_hostname }}"

data_dir   = "{{ nomad_working_dir }}"

bind_addr  = "{{ ansible_facts['default_ipv4']['address'] }}"
retry_join = ["{{ retry_join_hosts | join('", "') }}"]

# bind_addr above is pinned to the literal private IP (see consul.d/server.hcl.j2
# for why: "0.0.0.0" produced a dual-stack listener vulnerable to macOS's stale
# IPv6 default routes). That also moves the HTTP API off 0.0.0.0 by default,
# breaking anything using `nomad` CLI / localhost:4646 locally. Put it back
# explicitly - only rpc/serf (the actual cluster gossip ports) need to stay
# pinned to the literal IP.
addresses {
  http = "0.0.0.0"
}

# Control plane on this box
server {
  enabled = {{ server.enabled | default(false) | lower }}
{% if server.enabled | default(false) %}
  bootstrap_expect = {{ ns.servers | length }}
{% endif %}
}

# Also schedule workloads here
client {
  enabled = true

  preferred_address_family = "ipv4"

  {% if seaweedfs.volume.enabled | default(false) and seaweedfs.volume.path is defined %}
  host_volume "seaweedfs-data" {
    path = "{{ seaweedfs.volume.path }}"
  }
  {% endif %}

  {% if volumes is defined and volumes | length > 0 %}
  {% for volume in volumes %}
  host_volume "{{ volume.name }}" {
    path = "{{ volume.path }}"
  }
  {% endfor %}
  {% endif %}

  # Tagging helps constrain jobs later
  node_class = "worker"

  # Every inventory group this host belongs to, so a job can target any
  # group with `constraint { attribute = "${meta.inventory_groups}"
  # operator = "set_contains" value = "<group>" }` - no per-job meta needed.
  # os_* are the playbook's own group_by groups, not inventory groups.
  # nomad_client_meta (plus any nomad_client_meta__<suffix> dicts) adds
  # arbitrary extra keys.
  meta {
    inventory_groups = "{{ group_names | reject('in', ['all', 'ungrouped']) | reject('match', 'os_') | sort | join(',') }}"
{% for key, value in nomad_client_meta_merged | dictsort %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }
}

plugin "raw_exec" {
  config { enabled = true } 
}

{% if container.enabled | default(false) %}
plugin "nomad-driver-container" {
  config {
    container_path = "{{ homebrew_dir }}/bin/container"

    gc {
      container = true
    }

    disable_log_collection = false
  }
}
{% endif %}


{% if podman.enabled | default(false) %}
plugin "nomad-driver-podman" {
  config {
    socket_path = "{{ podman_socket_path }}"
  }
}
{% endif %}

{% if docker.enabled | default(false) %}
plugin "docker" {
  config {
    endpoint = "unix:///var/run/docker.sock"
    allow_privileged = false
    gc {
      image = true
      container = true
    }
    volumes {
      enabled = true
    }
  }
}
{% endif %}

# Service discovery
consul {
  address = "127.0.0.1:8500"
}

# Optional but handy for debugging
telemetry {
  publish_allocation_metrics = true
  publish_node_metrics       = true
}
