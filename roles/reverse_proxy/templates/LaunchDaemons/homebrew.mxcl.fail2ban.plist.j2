<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>{{ reverse_proxy_fail2ban_launchdaemon_label }}</string>
        <key>ProgramArguments</key>
        <array>
            <string>{{ homebrew_dir }}/opt/fail2ban/bin/fail2ban-client</string>
            <string>-x</string>
            <string>start</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>StandardErrorPath</key>
        <string>{{ log_dir }}/{{ reverse_proxy_fail2ban_log_file }}</string>
        <key>StandardOutPath</key>
        <string>{{ log_dir }}/{{ reverse_proxy_fail2ban_log_file }}</string>
    </dict>
</plist>
