<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>{{ reverse_proxy_pf_enable_launchdaemon_label }}</string>
        <key>ProgramArguments</key>
        <array>
            <string>/bin/sh</string>
            <string>{{ config_dir }}/{{ reverse_proxy_pf_enable_script_name }}</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>StandardErrorPath</key>
        <string>{{ log_dir }}/{{ reverse_proxy_pf_enable_log_file }}</string>
        <key>StandardOutPath</key>
        <string>{{ log_dir }}/{{ reverse_proxy_pf_enable_log_file }}</string>
    </dict>
</plist>
