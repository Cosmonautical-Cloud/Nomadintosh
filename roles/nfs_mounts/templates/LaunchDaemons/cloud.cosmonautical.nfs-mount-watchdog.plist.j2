<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>cloud.cosmonautical.nfs-mount-watchdog</string>
        <key>ProgramArguments</key>
        <array>
            <string>/bin/sh</string>
            <string>{{ config_dir }}/nfs-mount-watchdog.sh</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>StartInterval</key>
        <integer>{{ nfs_mounts_watchdog_interval }}</integer>
        <key>StandardErrorPath</key>
        <string>{{ log_dir }}/nfs-mount-watchdog.log</string>
        <key>StandardOutPath</key>
        <string>{{ log_dir }}/nfs-mount-watchdog.log</string>
    </dict>
</plist>
