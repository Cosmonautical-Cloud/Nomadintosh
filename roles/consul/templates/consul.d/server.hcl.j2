{# consul_datacenter is set by the set_facts role: the domain label shared by
   the Consul servers (cassiopeia.cosmonautical.cloud -> cosmonautical), so
   clients from other domains still join the servers' datacenter.
   existing_consul_datacenter and existing_cluster_servers are optional - set
   them (e.g. via Semaphore variable groups or extra-vars) when this run's own
   inventory doesn't include the real Consul servers (e.g. a Semaphore run
   scoped to just the jellify hosts) and these hosts should join that
   already-running control plane instead. #}
{% set ns = namespace(servers=[]) %}
{% for host in groups['all'] %}
{%   if 'server' in hostvars[host] and hostvars[host]['server'] is mapping and hostvars[host]['server']['enabled'] | default(false) %}
{%     set ns.servers = ns.servers + [host] %}
{%   endif %}
{% endfor %}
{% set datacenter = consul_datacenter %}
{% set retry_join_hosts = (ns.servers + (existing_cluster_servers | default([]))) | unique %}
datacenter = "{{ datacenter }}"
node_name  = "{{ inventory_hostname_short }}"
data_dir   = "{{ consul_working_dir }}"

server = {{ server.enabled | default(false) | lower }}
{% if server.enabled | default(false) %}
bootstrap_expect = {{ ns.servers | length }}
{% endif %}
ui = {{ server.enabled | default(false) | lower }}

bind_addr      = "{{ ansible_facts['default_ipv4']['address'] }}"
client_addr    = "0.0.0.0"
advertise_addr = "{{ ansible_facts['default_ipv4']['address'] }}"

retry_join = ["{{ retry_join_hosts | join('", "') }}"]
